# NetMirror Panel Configuration
# Copy to .env and customize

# === Network Settings ===
LISTEN_IP=0.0.0.0
HTTP_PORT=3000

# === Server Information ===
# Leave empty for auto-detection
LOCATION=
PUBLIC_IPV4=
PUBLIC_IPV6=

# === Admin Panel ===
# Required for admin access and token management
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=your-secret-api-key-here

# Data directory for persistent storage
DATA_DIR=/data

# === Branding ===
# Browser tab title
APP_TITLE=NetMirror

# === Feature Toggles ===
DISPLAY_TRAFFIC=true
ENABLE_SPEEDTEST=true
UTILITIES_PING=true
UTILITIES_MTR=true
UTILITIES_TRACEROUTE=true
UTILITIES_SPEEDTESTDOTNET=true
UTILITIES_FAKESHELL=true
UTILITIES_IPERF3=true

# === Feature Configuration ===
SPEEDTEST_FILE_LIST=100MB 1GB 10GB
UTILITIES_IPERF3_PORT_MIN=30000
UTILITIES_IPERF3_PORT_MAX=31000

# === Current Node Info ===
# Set these for the panel node itself
LG_CURRENT_NAME=Master Node
LG_CURRENT_LOCATION=Local
LG_CURRENT_URL=http://localhost:3000

# === Sponsor Message (Optional) ===
# Supports: file path, URL, HTML, Markdown, or plain text
# SPONSOR_MESSAGE=
